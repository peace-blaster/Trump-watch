#!/usr/bin/env python3
"""Trump watch: published YouGov approval tracker, standard library only."""
import argparse
import datetime as dt
import io
import json
import math
import os
from pathlib import Path
import re
import sys
import tempfile
import urllib.request
import zipfile
import xml.etree.ElementTree as ET

SOURCE = 'https://yougov.com/en-us/trackers/donald-trump-approval'
DOWNLOAD = 'https://api-test.yougov.com/public-data/v5/us/trackers/donald-trump-approval/download/'
QUESTION = 'Do you approve or disapprove of the way Donald Trump is handling his job as President?'
POPULATION = 'US Registered Voters'
NS = {'m': 'http://schemas.openxmlformats.org/spreadsheetml/2006/main'}
LIMIT = 10 * 1024 * 1024


def parse_workbook(data):
    """Read the explicitly named overall sheet; reject unknown schemas."""
    with zipfile.ZipFile(io.BytesIO(data)) as z:
        if sum(i.file_size for i in z.infolist()) > 40 * 1024 * 1024:
            raise ValueError('Workbook expands beyond size limit')
        def xml(name):
            raw = z.read(name)
            if b'<!DOCTYPE' in raw or b'<!ENTITY' in raw:
                raise ValueError('Unsupported XML declarations')
            return ET.fromstring(raw)
        sheets = xml('xl/workbook.xml').findall('m:sheets/m:sheet', NS)
        matches = [s for s in sheets if s.get('name') == POPULATION]
        if len(matches) != 1:
            raise ValueError('Expected overall population sheet missing')
        rid = matches[0].get('{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id')
        rels = xml('xl/_rels/workbook.xml.rels')
        target = next(r.get('Target') for r in rels if r.get('Id') == rid)
        name = target.lstrip('/') if target.startswith('/') else 'xl/' + target
        shared = []
        if 'xl/sharedStrings.xml' in z.namelist():
            shared = [''.join(s.itertext()) for s in xml('xl/sharedStrings.xml')]
        rows = []
        for row in xml(name).findall('m:sheetData/m:row', NS):
            cells = {}
            for c in row:
                col = re.fullmatch(r'([A-Z]+)[0-9]+', c.get('r', ''))
                if col is None or c.find('m:f', NS) is not None:
                    raise ValueError('Unsupported cell or formula')
                value = ''.join(c.itertext())
                if c.get('t') == 's':
                    value = shared[int(value)]
                cells[col[1]] = value
            rows.append(cells)
    if not rows or rows[0].get('A') != QUESTION:
        raise ValueError('Polling question changed')
    labels = {r.get('A'): r for r in rows[1:]}
    expected = ['Approve', 'Disapprove', 'Not sure', 'Unweighted base', 'Base']
    if any(k not in labels for k in expected):
        raise ValueError('Required response/base labels missing')
    records = []
    for col, date in rows[0].items():
        if col == 'A':
            continue
        day = dt.date.fromisoformat(date)
        if day > dt.datetime.now(dt.timezone.utc).date():
            raise ValueError('Source contains a future tracker date')
        values = [labels[k].get(col, '') for k in expected]
        if all(v == '' for v in values):
            continue
        nums = [float(v) for v in values]
        if not all(math.isfinite(v) for v in nums):
            raise ValueError('Non-finite data')
        if any(v < 0 or v > 1 for v in nums[:3]) or not .98 <= sum(nums[:3]) <= 1.02:
            raise ValueError('Invalid response percentages')
        if any(v <= 0 or not v.is_integer() for v in nums[3:]):
            raise ValueError('Invalid sample base')
        records.append(dict(date=date, approve=round(nums[0]*100, 6),
                            disapprove=round(nums[1]*100, 6), not_sure=round(nums[2]*100, 6),
                            unweighted_base=int(nums[3]), base=int(nums[4])))
    if not records or len({r['date'] for r in records}) != len(records):
        raise ValueError('No data or duplicate tracker dates')
    return sorted(records, key=lambda r: r['date'])


def fetch():
    request = urllib.request.Request(DOWNLOAD, headers={'User-Agent': 'Trump-watch/1.0 (public polling CLI)'})
    with urllib.request.urlopen(request, timeout=30) as response:
        if not response.url.startswith('https://'):
            raise ValueError('Source redirected away from HTTPS')
        data = response.read(LIMIT + 1)
    if len(data) > LIMIT:
        raise ValueError('Download exceeds size limit')
    parse_workbook(data)
    return data


def save_cache(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp = tempfile.mkstemp(dir=str(path.parent), prefix='.trump-watch-')
    try:
        with os.fdopen(fd, 'wb') as f:
            f.write(data)
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def positive(value):
    n = int(value)
    if n < 1:
        raise argparse.ArgumentTypeError('must be positive')
    return n


def print_report(result):
    """Render published values with ASCII graphics and optional terminal color."""
    color = sys.stdout.isatty() and os.environ.get('TERM', '') != 'dumb' and 'NO_COLOR' not in os.environ

    def style(text, code):
        return '\033[%sm%s\033[0m' % (code, text) if color else text

    rule = '  ' + '-' * 62
    print()
    print(style('          /\\       TRUMP WATCH', '1;36'))
    print(style('      ___/  \\___   Presidential job approval', '36'))
    print('      | [] [] |   YouGov / ' + result['population'])
    print('      | || || |')
    print('     ===========')
    print(rule)
    print('  Status     ' + result['status'])
    retrieved = dt.datetime.fromisoformat(result['retrieved_at'])
    print('  Retrieved  ' + retrieved.astimezone(dt.timezone.utc).strftime('%Y-%m-%d %H:%M UTC'))
    age = result['latest_tracker_age_days']
    freshness = '%d day%s old' % (age, '' if age == 1 else 's')
    if result['stale']:
        freshness += ' / STALE (over 14 days)'
    print('  Freshness  ' + style(freshness, '33' if result['stale'] else '2'))
    print(rule)
    latest = result['polls'][-1]
    print(style('  LATEST / ' + latest['date'], '1'))
    print('  Source tracker date / Unweighted base: {:,}'.format(latest['unweighted_base']))
    print()
    for label, key in [('Approve', 'approve'), ('Disapprove', 'disapprove'), ('Not sure', 'not_sure')]:
        value = latest[key]
        filled = int(value * 24 / 100 + .5)
        bar = '#' * filled + '.' * (24 - filled)
        print('  %-10s %7s  %s' % (label, '%g%%' % value, style('[' + bar + ']', '36')))
    print(' ' * 23 + '0%                      100%')
    if len(result['polls']) > 1:
        print()
        print(style('  HISTORY / source tracker dates', '1'))
        print('  Date         Approve  Disapprove  Not sure  Unweighted base')
        for r in result['polls']:
            print('  %s  %7s  %10s  %8s  %15s' % (
                r['date'], '%g%%' % r['approve'], '%g%%' % r['disapprove'],
                '%g%%' % r['not_sure'], format(r['unweighted_base'], ',')))
    print(rule)
    print('  Full fieldwork intervals are not supplied in this download.')
    print('  Source:   ' + result['source_url'])
    print('  Download: ' + result['download_url'])
    print()


def main(argv=None):
    parser = argparse.ArgumentParser(description='Trump watch — published YouGov approval polling')
    parser.add_argument('--offline', action='store_true', help='use the last successful download only')
    parser.add_argument('--history', type=positive, default=1, metavar='N', help='show the last N published tracker dates')
    parser.add_argument('--json', action='store_true', help='machine-readable output')
    parser.add_argument('--cache-dir', type=Path, default=Path(os.environ.get('XDG_CACHE_HOME', str(Path.home()/'.cache')))/'trump-watch')
    parser.add_argument('--version', action='version', version='Trump watch 1.0.0')
    args = parser.parse_args(argv)
    path = args.cache_dir / 'polls.xlsx'
    status = 'offline cache' if args.offline else 'live download'
    warning = None
    checked = None
    code = 0
    try:
        if args.offline:
            data = path.read_bytes()
            checked = dt.datetime.fromtimestamp(path.stat().st_mtime, dt.timezone.utc).isoformat()
        else:
            try:
                data = fetch()
                checked = dt.datetime.now(dt.timezone.utc).isoformat()
            except (OSError, ValueError, KeyError, IndexError, StopIteration, zipfile.BadZipFile, ET.ParseError) as e:
                warning = 'Refresh failed: ' + str(e)
                data = path.read_bytes()
                checked = dt.datetime.fromtimestamp(path.stat().st_mtime, dt.timezone.utc).isoformat()
                status = 'cached fallback; live refresh failed'
                code = 2
            else:
                try:
                    save_cache(path, data)
                except OSError as e:
                    warning = 'Live data loaded but cache could not be saved: ' + str(e)
        records = parse_workbook(data)
        age = (dt.datetime.now(dt.timezone.utc).date() - dt.date.fromisoformat(records[-1]['date'])).days
        result = dict(source='YouGov', source_url=SOURCE, download_url=DOWNLOAD,
                      population=POPULATION, question=QUESTION, status=status,
                      retrieved_at=checked, latest_tracker_age_days=age, stale=age > 14,
                      date_note='Source tracker dates; full fieldwork intervals are not supplied in this download.',
                      warning=warning, polls=records[-args.history:])
        if args.json:
            print(json.dumps(result, indent=2))
        else:
            print_report(result)
        if warning:
            print('Warning: ' + warning, file=sys.stderr)
        return code
    except (OSError, ValueError, KeyError, IndexError, StopIteration, zipfile.BadZipFile, ET.ParseError) as e:
        print('Trump watch: no usable polling data: ' + str(e), file=sys.stderr)
        return 1


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
